{
  "name": "angular-portfolio",
  "version": "0.0.0",
  "engines": {
    "node": "^22.22.3"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/absolutize-preload-links.mjs && node scripts/publish-404-page.mjs && node scripts/generate-csp-headers.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --coverage",
    "test:worker": "node --test \"cloudflare-worker/*.test.mjs\"",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\" \"cloudflare-worker/**/*.{js,mjs}\" \"scripts/**/*.mjs\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.html\" \"cloudflare-worker/**/*.{js,mjs}\" \"scripts/**/*.mjs\" --fix",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "ci:security": "node scripts/security-audit.mjs",
    "ci:quality": "npm run lint && npm run test:coverage && npm run test:worker",
    "ci:build": "ng build --configuration=production && node scripts/absolutize-preload-links.mjs && node scripts/publish-404-page.mjs && node scripts/generate-csp-headers.mjs",
    "ci:smoke": "node scripts/smoke-test-production.mjs",
    "ci:artifact": "node scripts/check-deploy-artifact.mjs",
    "ci:a11y": "node scripts/a11y-scan.mjs",
    "ci:lighthouse": "node scripts/lighthouse.mjs",
    "check:live": "node scripts/check-live-site.mjs",
    "outdated:check": "npm outdated || node -e \"console.log('Outdated check complete (informational only, not blocking).')\"",
    "ci:local": "npm run outdated:check && npm run ci:security && npm run ci:quality && npm run ci:build && npm run ci:smoke && npm run ci:a11y"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "tar": ">=7.5.11",
    "uuid": ">=14.0.0",
    "postcss": ">=8.5.10",
    "brace-expansion": ">=5.0.12",
    "tmp": ">=0.2.6",
    "ws": ">=8.21.0",
    "fast-uri": ">=4.2.3",
    "@hono/node-server": ">=2.0.5",
    "js-yaml": ">=5.4.1",
    "qs": ">=6.16.0",
    "piscina": "^5.3.2",
    "minimatch": "^11.0.1",
    "bfsg-scanner": {
      "playwright": "$@playwright/test"
    }
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "bfsg-scanner": "^0.4.1",
    "eslint": "^10.14.0",
    "parse5": "^8.1.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
