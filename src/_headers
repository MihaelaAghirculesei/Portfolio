/*
  # CSP for static Cloudflare Pages serving (pre-rendered Angular build).
  # - unsafe-eval removed: AOT compilation does not require dynamic eval.
  # - unsafe-inline removed from script-src: Angular's application builder
  #   emits only external JS bundles for actual application code — but
  #   prerendering + hydration (jsaction event replay, transfer-state
  #   __nghData__, and JSON-LD structured data) DOES emit several inline
  #   <script> blocks per route, and their content differs per route (the
  #   jsaction bootstrap call lists exactly the event types that route
  #   binds, transfer-state and JSON-LD are route-specific data). A single
  #   hardcoded hash here goes stale the moment any route's inline content
  #   changes — see the incident this replaced. `npm run build` now runs
  #   scripts/generate-csp-headers.mjs as a postbuild step, which scans
  #   every prerendered index.html, hashes every distinct inline <script>,
  #   and rewrites the placeholder token in the Content-Security-Policy line
  #   below (in dist/, not this file) with the exact deduplicated set for
  #   that build. Keep this file as the template; do not hand-edit a hash
  #   back in here, and do not repeat the placeholder token itself anywhere
  #   in this comment block — the generator script does a single, literal,
  #   first-match replace, and a second occurrence earlier in the file (e.g.
  #   in this comment) silently steals it instead of the real header line.
  # - style-src retains unsafe-inline: Angular injects component CSS as <style>
  #   elements at hydration time. Nonce-based style enforcement is handled by
  #   the SSR Express server (server.ts) for Node.js deployments; the static
  #   fallback here keeps unsafe-inline scoped to styles only.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-hashes' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.aghirculesei.workers.dev; base-uri 'self'; form-action 'self';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/i18n/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
